{
  "name": "worldgen",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:deploy": "pnpm build && pnpm generate && rm -R dist/server",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "generate": "pnpm build:server && node prerender.js",
    "format": "dprint fmt",
    "lint": "eslint src/main src/test",
    "serve": "vite preview",
    "test": "vitest",
    "test:load": "vite build -l warn --ssr src/tryLoadVersion.ts --outDir dist/test && node dist/test/tryLoadVersion.js"
  },
  "dependencies": {
    "@delangle/use-modal": "^1.9.41",
    "fflate": "^0.8.2",
    "file-saver": "^2.0.5",
    "idb-keyval": "^6.2.1",
    "leaflet": "^1.9.4",
    "nanoid": "^5.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-feather": "^2.0.10",
    "react-hot-toast": "^2.5.2",
    "react-json-view-lite": "^2.3.0",
    "react-select": "^5.10.1",
    "react-window": "^1.8.11",
    "use-local-storage-state": "^19.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@rollup/pluginutils": "^5.1.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/file-saver": "^2.0.7",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.3.4",
    "chalk": "^5.4.1",
    "dotenv": "^16.4.7",
    "dprint": "^0.49.0",
    "eslint": "^9.21.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.0.0",
    "react-select-event": "^5.5.1",
    "sass": "^1.85.1",
    "tslib": "^2.8.1",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.2.5",
    "vitest": "^3.0.7"
  }
}
