{
  "name": "worldgen",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:deploy": "pnpm build && pnpm generate && rm -R dist/server",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "generate": "pnpm build:server && node prerender.js",
    "format": "dprint fmt",
    "lint": "eslint src/main src/test",
    "serve": "vite preview",
    "test": "vitest",
    "test:load": "vite build -l warn --ssr src/tryLoadVersion.ts --outDir dist/test && node dist/test/tryLoadVersion.js"
  },
  "dependencies": {
    "@delangle/use-modal": "^1.9.41",
    "fflate": "^0.8.2",
    "file-saver": "^2.0.5",
    "idb-keyval": "^6.2.1",
    "json-view-for-react": "^2.0.1",
    "leaflet": "^1.9.4",
    "nanoid": "^5.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-feather": "^2.0.10",
    "react-hot-toast": "^2.4.1",
    "react-select": "^5.8.0",
    "react-window": "^1.8.10",
    "use-local-storage-state": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.0",
    "@rollup/pluginutils": "^5.1.0",
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^15.0.7",
    "@types/file-saver": "^2.0.7",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20.12.10",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.2.1",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.5",
    "dprint": "^0.45.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^24.0.0",
    "react-select-event": "^5.5.1",
    "sass": "^1.77.0",
    "tslib": "^2.6.2",
    "typescript": "~5.4.5",
    "typescript-eslint": "^7.8.0",
    "vite": "^5.2.11",
    "vitest": "^1.6.0"
  }
}
