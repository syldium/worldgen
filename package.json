{
  "name": "worldgen",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.6.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:deploy": "pnpm build && pnpm generate && rm -R dist/server",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "generate": "pnpm build:server && node prerender.js",
    "format": "dprint fmt",
    "lint": "eslint src/main src/test",
    "serve": "vite preview",
    "test": "vitest",
    "test:load": "vite build -l warn --ssr src/tryLoadVersion.ts --outDir dist/test && node dist/test/tryLoadVersion.js"
  },
  "dependencies": {
    "@delangle/use-modal": "^1.9.41",
    "fflate": "^0.8.2",
    "file-saver": "^2.0.5",
    "idb-keyval": "^6.2.1",
    "json-view-for-react": "^2.0.1",
    "leaflet": "^1.9.4",
    "nanoid": "^5.0.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-feather": "^2.0.10",
    "react-hot-toast": "^2.4.1",
    "react-select": "^5.8.3",
    "react-window": "^1.8.10",
    "use-local-storage-state": "^19.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@rollup/pluginutils": "^5.1.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/file-saver": "^2.0.7",
    "@types/leaflet": "^1.9.15",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.3.4",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.7",
    "dprint": "^0.47.6",
    "eslint": "^9.16.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^25.0.1",
    "react-select-event": "^5.5.1",
    "sass": "^1.82.0",
    "tslib": "^2.8.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.3",
    "vitest": "2.1.6"
  }
}
